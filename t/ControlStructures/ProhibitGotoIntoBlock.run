## name Null test
## failures 0
## cut

say 'Hello, world!';

## name Goto to same or outer scope is OK
## failures 0
## cut

{
    goto FOO;
    FOO: ;
}

{
    goto BAR;
}
BAR: ;

goto BAZ;
BAZ: ;

## name Goto to inner scope is not OK
## failures 1
## cut

goto FOO;
{
    FOO: ;
}

## name Goto to disjoint scope is not OK
## failures 1
## cut

{
    goto BAR;
}

{
    BAR: ;
}

## name Goto into inner or disjoing do {} is not OK
## failures 2
## cut

goto FOO;
do {
    FOO: ;
};

{
    goto BAR;
}

do {
    BAR: ;
};

## name Goto into while() is not OK
## failures 1
## cut

goto FOO;

while ( ! $$ ) {    # Very probably false, but shouldn't be optimized out.
    FOO: say 'plugh';
}

## name Goto into sub {} is not OK, though maybe different error
## failures 1
## cut

goto FOO;

sub bar {
    say 'called';
    FOO: say 'bar';
    return;
}

## name Goto into for ( ... ) { ... } or foreach ( ... ) { ... } is not OK
## failures 2
## cut

goto FOO;

for ( 1 .. 3 ) {
    say;
    FOO: say 'foo';
}

goto BAR;

foreach ( 4 .. 6 ) {
    say;
    BAR: say 'bar';
}

## name Goto into given ( ... ) { ... } is not OK
## failures 1
## cut

goto UNIT;

given ( $ARGV[0] ) {
    when ( undef ) { say 'Undefined' }
    when ( 0 ) { say 'Nil' }
    when ( 1 ) { UNIT: say 'Unit' }
    when ( 2 ) { say 'Pair' }
    default { say "<'$_' is unknown>" }
}

## name Goto into if ( ... ) { ... } elsif ( ... ) { ... } else { ... } not OK
## failures 3
## cut

my $word = 'xyzzy';

goto FOO;
goto BAR;
goto DFLT;

if ( $word eq 'foo' ) {
    FOO:
    say 'Foo!';
} elsif ( $word eq 'bar' ) {
    BAR:
    say 'Bar!';
} else {
    DFLT:
    say "'$word'";
}

## name Perl #132799 correctly classified
## failures 0
## cut

# From t/op/goto.t
# [perl #132799]
# Erroneous inward goto warning, followed by crash.
# The eval must be in an assignment.
sub _routine {
    my $e = eval {
        goto L2;
      L2:
    }
}

## name Goto do { ... } ignored
## failures 0
## cut

goto do { foo() };

## name Goto do; is not ignored
## failures 1
## cut

goto do;
{ do: }

## name Goto subroutine() ignored
## failures 0
## cut

# NOTE that in Perl v5.42.0 'goto subroutine();' is a syntax error, so
# the functionality this tests is pure paranoia. NOTE also that this is
# not the same as 'goto &subroutine' unless subroutine() actually
# returns a code reference.

goto subroutine();

## name Goto non-existent label is ignored
## failures 0
## cut

goto FUBAR;
BAZ:    # Policy disables itself if no labels at all.

__END__

